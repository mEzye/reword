import { Button, LineEdit, Slider, ComboBox, VerticalBox, HorizontalBox, AboutSlint, Palette, ScrollView } from "std-widgets.slint";

export struct WaveBar { x: float, height: float, alpha: float }

export component Overlay inherits Window {
    title: "Reword";
    width: 224px;
    height: 90px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <color> panel-color;
    in property <color> accent-color;
    in property <float> shell-width: 22;
    in property <float> shell-height: 7;
    in property <float> visibility: 0;
    in property <float> offset-y: 0;
    in property <float> mic-x: 112;
    in property <float> mic-scale: 1;
    in property <float> mic-alpha: 0;
    in property <[WaveBar]> bars;

    shell := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2 + root.offset-y * 1px;
        width: root.shell-width * 1px;
        height: root.shell-height * 1px;
        border-radius: self.height / 2;
        background: root.panel-color.with-alpha(root.visibility);
        border-width: 1px;
        border-color: #ffffff.with-alpha(root.visibility * 0.0863);

        for bar in root.bars: Rectangle {
            x: bar.x * 1px - shell.x - self.width / 2;
            y: (parent.height - self.height) / 2;
            width: 2.6px;
            height: max(0px, bar.height * 1px);
            border-radius: 1.3px;
            background: root.accent-color;
            opacity: bar.alpha * root.visibility;
        }
        Image {
            x: root.mic-x * 1px - shell.x - self.width / 2;
            y: (parent.height - self.height) / 2;
            height: min(24px * root.mic-scale, max(0px, parent.height - 4px));
            width: self.height;
            source: @image-url("../assets/mic.svg");
            colorize: root.accent-color;
            image-fit: contain;
            opacity: root.mic-alpha * root.visibility;
        }
    }
}

component CommitField inherits LineEdit {
    property <string> original-text;
    property <bool> editing: false;
    callback commit(string);
    callback leave();
    changed has-focus => {
        if (self.has-focus) {
            self.original-text = self.text;
            self.editing = true;
        } else if (self.editing) {
            self.editing = false;
            root.commit(self.text);
        }
    }
    accepted(value) => {
        if (self.editing) {
            self.editing = false;
            root.commit(value);
        }
        root.leave();
    }
    key-pressed(event) => {
        if (event.text == Key.Escape) {
            self.text = self.original-text;
            self.editing = false;
            root.leave();
            return accept;
        }
        return reject;
    }
}

export component Preferences inherits Window {
    title: "Reword · Налаштування";
    preferred-width: 520px;
    preferred-height: 472px;
    min-width: 480px;
    min-height: 360px;
    background: #191d23;
    default-font-size: 14px;
    init => { Palette.color-scheme = ColorScheme.dark; }
    in-out property <string> background-hex;
    in-out property <string> accent-hex;
    in-out property <string> message: "";
    in property <color> panel-color;
    in property <color> accent-color;
    in-out property <float> open-speed: 1;
    in-out property <float> close-speed: 1;
    in-out property <float> master-speed: 1;
    in-out property <string> open-speed-text: "1";
    in-out property <string> close-speed-text: "1";
    in-out property <string> master-speed-text: "1";
    in-out property <int> palette-index: 0;
    in property <[string]> palette-names;
    in-out property <string> scheme-name;
    callback apply(string, string);
    callback preview();
    callback preset(int);
    callback speed-changed(float, float, float);
    callback speed-edited(int, string);
    callback color-edited(int, string);
    callback save-scheme(string, string, string);
    changed background-hex => { root.color-edited(0, root.background-hex); }
    changed accent-hex => { root.color-edited(1, root.accent-hex); }

    focus-sink := FocusScope { width: 1px; height: 1px; }
    TouchArea {
        width: 100%; height: 100%;
        clicked => { focus-sink.focus(); }
    }

    VerticalBox {
        padding: 16px;
        spacing: 8px;
        ScrollView {
            min-height: 0px;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            content-height: 360px;
            Rectangle {
                width: parent.visible-width;
                height: 360px;
                TouchArea {
                    width: 100%; height: 100%;
                    clicked => { focus-sink.focus(); }
                }
                VerticalBox {
                width: 100%; height: 100%;
                padding: 0px;
                padding-right: 8px;
                spacing: 8px;
                HorizontalBox {
                    height: 40px; padding: 0px; spacing: 16px;
                    VerticalBox {
                        padding: 0px; spacing: 0px;
                        Text { text: "Reword"; color: #eef0f3; font-size: 22px; }
                    }
                    Rectangle {
                        width: 164px; height: 36px; border-radius: 18px;
                        background: root.panel-color;
                        border-width: 1px; border-color: #ffffff16;
                        Image { x: 12px; y: 8px; width: 20px; height: 20px;
                            source: @image-url("../assets/mic.svg"); colorize: root.accent-color;
                        }
                        for h[i] in [8, 17, 11, 22, 9, 15, 6, 20, 12, 7, 16, 10]: Rectangle {
                            x: 45px + i * 8px; y: (36px - h * 1px) / 2;
                            width: 3px; height: h * 1px; border-radius: 1.5px;
                            background: root.accent-color;
                        }
                    }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 12px;
                    Text { text: "Фон панелі"; color: #eef0f3; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle { width: 24px; height: 24px; border-radius: 6px; background: root.panel-color; border-width: 1px; border-color: #ffffff20; }
                    CommitField { text <=> root.background-hex; min-width: 112px; max-width: 112px; horizontal-stretch: 0;
                        leave => { focus-sink.focus(); }
                    }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 12px;
                    Text { text: "Мікрофон і хвилі"; color: #eef0f3; vertical-alignment: center; horizontal-stretch: 1; }
                    Rectangle { width: 24px; height: 24px; border-radius: 6px; background: root.accent-color; }
                    CommitField { text <=> root.accent-hex; min-width: 112px; max-width: 112px; horizontal-stretch: 0;
                        leave => { focus-sink.focus(); }
                    }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 12px;
                    Text { text: "Колірна схема"; color: #eef0f3; vertical-alignment: center; horizontal-stretch: 1; }
                    ComboBox {
                        min-width: 192px; max-width: 192px;
                        model: root.palette-names;
                        current-index <=> root.palette-index;
                        selected => { root.preset(self.current-index); }
                    }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 8px;
                    CommitField {
                        text <=> root.scheme-name;
                        placeholder-text: "Назва своєї схеми";
                        min-width: 120px; horizontal-stretch: 1;
                        leave => { focus-sink.focus(); }
                    }
                    Button {
                        text: "Зберегти схему";
                        min-width: 144px; max-width: 144px;
                        enabled: root.scheme-name != "";
                        clicked => { root.save-scheme(root.scheme-name, root.background-hex, root.accent-hex); }
                    }
                }
                HorizontalBox {
                    height: 20px; padding: 0px;
                    Text { text: "Швидкість анімації"; color: #eef0f3; font-size: 16px; horizontal-stretch: 1; }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 8px;
                    Text { text: "Поява"; color: #eef0f3; width: 88px; vertical-alignment: center; }
                    Slider { minimum: 0.25; maximum: 3; step: 0.05; value <=> root.open-speed; min-width: 120px; horizontal-stretch: 1;
                        changed => { root.speed-changed(root.open-speed, root.close-speed, root.master-speed); }
                    }
                    CommitField { text <=> root.open-speed-text; min-width: 72px; max-width: 72px; horizontal-stretch: 0; horizontal-alignment: right;
                        commit(value) => { root.speed-edited(0, value); }
                        leave => { focus-sink.focus(); }
                    }
                    Text { text: "×"; color: #a6adb8; width: 12px; vertical-alignment: center; }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 8px;
                    Text { text: "Зникнення"; color: #eef0f3; width: 88px; vertical-alignment: center; }
                    Slider { minimum: 0.25; maximum: 3; step: 0.05; value <=> root.close-speed; min-width: 120px; horizontal-stretch: 1;
                        changed => { root.speed-changed(root.open-speed, root.close-speed, root.master-speed); }
                    }
                    CommitField { text <=> root.close-speed-text; min-width: 72px; max-width: 72px; horizontal-stretch: 0; horizontal-alignment: right;
                        commit(value) => { root.speed-edited(1, value); }
                        leave => { focus-sink.focus(); }
                    }
                    Text { text: "×"; color: #a6adb8; width: 12px; vertical-alignment: center; }
                }
                HorizontalBox {
                    height: 32px; padding: 0px; spacing: 8px;
                    Text { text: "Разом"; color: #eef0f3; width: 88px; vertical-alignment: center; }
                    Slider { minimum: 0.25; maximum: 3; step: 0.05; value <=> root.master-speed; min-width: 120px; horizontal-stretch: 1;
                        changed => { root.speed-changed(root.open-speed, root.close-speed, root.master-speed); }
                    }
                    CommitField { text <=> root.master-speed-text; min-width: 72px; max-width: 72px; horizontal-stretch: 0; horizontal-alignment: right;
                        commit(value) => { root.speed-edited(2, value); }
                        leave => { focus-sink.focus(); }
                    }
                    Text { text: "×"; color: #a6adb8; width: 12px; vertical-alignment: center; }
                }
                }
            }
        }
        HorizontalBox {
            height: 36px; padding: 0px; spacing: 8px;
            Button { text: "Застосувати кольори"; clicked => { root.apply(root.background-hex, root.accent-hex); } }
            Button { text: "Повторити анімацію"; clicked => { root.preview(); } }
        }
        HorizontalBox {
            height: 20px; padding: 0px; spacing: 8px;
            Text { text: root.message; color: #ffb482; font-size: 12px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
        }
    }
}
export component About inherits Window {
    title: "Про Reword";
    preferred-width: 340px;
    preferred-height: 240px;
    VerticalBox {
        padding: 24px;
        Text { text: "Reword 0.3.3"; font-size: 24px; horizontal-alignment: center; }
        Text { text: "Візуальний прототип диктовки\nІконка мікрофона: Lucide, ISC"; horizontal-alignment: center; }
        AboutSlint { }
    }
}

export component RewordTray inherits SystemTrayIcon {
    icon: @image-url("../assets/tray.svg");
    tooltip: "Reword · Ctrl+Alt+H";
    callback preview();
    callback preferences();
    callback about();
    callback quit();
    clicked => { root.preferences(); }
    Menu {
        MenuItem { title: "Повторити анімацію"; activated => { root.preview(); } }
        MenuItem { title: "Вигляд і анімація…"; activated => { root.preferences(); } }
        MenuItem { title: "Про Reword"; activated => { root.about(); } }
        MenuSeparator { }
        MenuItem { title: "Вийти з Reword"; activated => { root.quit(); } }
    }
}
